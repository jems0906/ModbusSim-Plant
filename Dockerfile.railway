FROM node:20-alpine AS plant-ui
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_READ_ONLY_DEMO=1
ENV VITE_READ_ONLY_DEMO=${VITE_READ_ONLY_DEMO}
RUN npm run build

FROM node:20-alpine AS alarm-ui
WORKDIR /src/alarmwatch/frontend
COPY alarmwatch/frontend/package*.json ./
RUN npm ci
COPY alarmwatch/frontend/ ./
ARG VITE_ALARM_BASE=/alarmwatch/
ARG VITE_ALARM_API_BASE=/alarm-api
ARG VITE_PLANT_API_BASE=/plant-api
ARG VITE_ALARM_WS_PATH=/alarm-ws
ARG VITE_READ_ONLY_DEMO=1
ENV VITE_ALARM_BASE=${VITE_ALARM_BASE}
ENV VITE_ALARM_API_BASE=${VITE_ALARM_API_BASE}
ENV VITE_PLANT_API_BASE=${VITE_PLANT_API_BASE}
ENV VITE_ALARM_WS_PATH=${VITE_ALARM_WS_PATH}
ENV VITE_READ_ONLY_DEMO=${VITE_READ_ONLY_DEMO}
RUN npm run build

FROM python:3.13-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends nginx gettext-base bash \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY simulator/ ./simulator/
COPY control/ ./control/
COPY api/ ./api/
COPY alarmwatch/collector.py alarmwatch/engine.py alarmwatch/main.py alarmwatch/rules.json alarmwatch/security.py ./alarmwatch/
COPY --from=plant-ui /src/frontend/dist/ /usr/share/nginx/html/
COPY --from=alarm-ui /src/alarmwatch/frontend/dist/ /usr/share/nginx/html/alarmwatch/
COPY deployment/railway-nginx.conf.template /etc/nginx/railway-nginx.conf.template
COPY deployment/start-railway.sh /app/deployment/start-railway.sh
RUN chmod +x /app/deployment/start-railway.sh
ENV MODBUS_HOST=127.0.0.1 \
    MODBUS_PORT=502 \
    ALARMAWATCH_MODBUS_HOST=127.0.0.1 \
    ALARMAWATCH_MODBUS_PORT=502 \
    ALARMAWATCH_AUDIT_API_URL=http://127.0.0.1:8000 \
    RAILWAY_READ_ONLY_DEMO=1
CMD ["/app/deployment/start-railway.sh"]